# Copy to .env for local development. docker-compose.yml sets these for the containers.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://orders:orders@localhost:5432/orders
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# API
PORT=3000
API_KEY=change-me-to-a-long-random-string
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50

# Worker (use PORT=3001 when running it next to the API)
WORKER_PREFETCH=10
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=1000
FAKE_PAYMENT_FAILURE_RATE=0
FAKE_PAYMENT_DECLINE_RATE=0
FAKE_PAYMENT_LATENCY_MS=50
